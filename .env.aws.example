# Amplify generates amplify_outputs.json after sandbox/deploy.
# Keep region here only for scripts and local helper APIs.
NEXT_PUBLIC_AWS_REGION=eu-north-1
NEXT_PUBLIC_AWS_APP_NAME=RaportarePEO_CPC

# Local deploy identifier. Do not prefix with NEXT_PUBLIC unless the app must read it in the browser.
AWS_APPLICATION_ARN=arn:aws:resource-groups:eu-north-1:<account-id>:group/RaportarePEO_CPC/<application-id>

# Optional AI features.
OPENAI_API_KEY=

NEXT_PUBLIC_AWS_REGION=eu-north-1
NEXT_PUBLIC_AWS_APP_NAME=RaportarePEO_CPC

# Optional AI features.
OPENAI_API_KEY=

# AI governance: audit trail, rate limit and budget guardrails.
# Use AI_AUDIT_LOG_PATH=console in serverless environments if only CloudWatch logging is desired.
AI_AUDIT_LOG_PATH=./data/audit/ai-audit.ndjson
AI_AUDIT_LOG_TO_CONSOLE=true
AI_AUDIT_FAIL_CLOSED=false
AI_AUDIT_MAX_FIELD_CHARS=50000
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=500
AI_DAILY_COST_LIMIT_USD=25
AI_MONTHLY_COST_LIMIT_USD=300
AI_REQUEST_COST_LIMIT_USD=2
AI_DEFAULT_EXPECTED_OUTPUT_TOKENS=1000

# Override when the configured model/provider has different pricing.
AI_MODEL_INPUT_COST_PER_1M_USD=0.15
AI_MODEL_OUTPUT_COST_PER_1M_USD=0.60
